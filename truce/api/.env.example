# mock = fake PayPal in memory (works on Day 1, no accounts needed)
# sandbox = real PayPal sandbox
PAYPAL_MODE=mock
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# From developer.paypal.com > Apps & Credentials > Sandbox. Seller (business) app:
PAYPAL_SELLER_CLIENT_ID=
PAYPAL_SELLER_CLIENT_SECRET=
# Only needed if PayPal gives your app the buyer scopes (spike 1):
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=
# Sandbox test account emails (used by the spike scripts)
SELLER_EMAIL=
BUYER_EMAIL=

AGENTS_URL=http://localhost:8000
# Leave empty to keep data in memory. Add an Atlas URL on Day 3.
MONGODB_URI=
POLL_SECONDS=45
PORT=4000
